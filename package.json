{
  "name": "animedubstatus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && tsc --noEmit -p infra && tsc --noEmit -p jobs",
    "test": "vitest run",
    "refresh-data": "tsx jobs/run-local.ts",
    "diff": "cdk diff --profile gulugulus",
    "deploy": "npm run build && node scripts/deploy.mjs full",
    "deploy:web": "npm run build && node scripts/deploy.mjs web",
    "destroy": "node scripts/deploy.mjs destroy"
  },
  "dependencies": {
    "nuxt": "^4.6.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24",
    "aws-cdk": "^2.1146.1",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "node-html-parser": "^9.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
